# ---- FoodBridge backend environment ----
# Local development copy: `cp backend/.env.example backend/.env`
PORT=5001

# MongoDB. Local Docker/mongod or a MongoDB Atlas SRV string in production.
MONGO_URI=mongodb://127.0.0.1:27017/foodbridge

# Required. The API refuses to start without a unique secret of 32+ chars.
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET

# Allowed frontend origin(s). Comma separated for local + production.
CLIENT_URL=http://localhost:5173

# The ONE primary administrator is provisioned only by `npm run seed`; admin
# accounts can never be created through public registration. 12+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARS

# Optional: enables POST /api/setup/admin (one-time bootstrap) on a hosted deploy.
SETUP_TOKEN=

# Password reset delivery (optional). Without these the API never returns a token.
RESET_LINK_BASE=
SMTP_URL=
