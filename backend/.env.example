# ---- FoodBridge backend environment ----
# Local development copy: `cp backend/.env.example backend/.env`
PORT=5001

# MongoDB. Local Docker/mongod or a MongoDB Atlas SRV string in production.
MONGO_URI=mongodb://127.0.0.1:27017/foodbridge

# Required. The API refuses to start without a unique secret of 32+ chars.
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET

# Allowed frontend origin(s). Comma separated for local + production.
CLIENT_URL=http://localhost:5173

# Administrators are provisioned only by `npm run seed`; they can never be
# created through public registration. Use 12+ character unique passwords.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_1_AT_LEAST_12_CHARS
ADMIN2_EMAIL=admin2@example.com
ADMIN2_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_2_AT_LEAST_12_CHARS

# Optional: enables POST /api/setup/admin (one-time bootstrap) on a hosted deploy.
SETUP_TOKEN=

# Password reset delivery (optional). Without these the API never returns a token.
RESET_LINK_BASE=
SMTP_URL=

# Optional local-only sample accounts and records. Keep both false in production.
SEED_SAMPLE_USERS=false
SEED_SAMPLE_DATA=false
