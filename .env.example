# ---- docker compose (local full stack) ----
# cp .env.example .env  then  JWT_SECRET=$(openssl rand -hex 32) docker compose up -d --build
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
# MongoDB container credentials (auth is always enabled)
MONGO_ROOT_USERNAME=foodbridge
MONGO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
CLIENT_URL=http://localhost:8080,http://localhost:5173
VITE_API_URL=http://localhost:5001/api

# Administrators (seed / first boot). 12+ characters, unique.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_1_AT_LEAST_12_CHARS
ADMIN2_EMAIL=admin2@example.com
ADMIN2_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_2_AT_LEAST_12_CHARS

# Optional: allows POST /api/setup/admin for a one-time bootstrap on a hosted deploy.
SETUP_TOKEN=
