{
  // Cloudflare Workers static deployment of the FoodBridge frontend.
  // The API is a separate Node/Express service (see OPERATIONS.md); point
  // VITE_API_URL at it before building, then:
  //   npx wrangler deploy --config deploy/wrangler.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "foodbridge",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application"
  }
}
